load("@com_google_protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//tools/base/bazel:proto.bzl", "android_java_proto_library")

package(default_visibility = ["//tools/base/android-test/coverage:__subpackages__"])

# The source of truth for the coverage data contract.
proto_library(
    name = "coverage_metadata_proto",
    srcs = ["coverage_metadata.proto"],
    visibility = ["//visibility:public"],
)

# C++ projection
cc_proto_library(
    name = "coverage_metadata_cc_proto",
    visibility = ["//visibility:public"],
    deps = [":coverage_metadata_proto"],
)

# Studio-compatible Java projection with JarJar support.
android_java_proto_library(
    name = "coverage_metadata_java_proto",
    srcs = ["coverage_metadata.proto"],
    visibility = ["//visibility:public"],
)
