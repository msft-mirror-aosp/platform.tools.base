# The class that instrumenter_test instruments.
java_library(
    name = "instrumenter_test_target",
    testonly = True,
    srcs = ["testdata/com/example/InstrumenterTestTarget.java"],
)

# The Android library, in which d8 looks up the classes of the platform that the
# test classes extend, such as Enum, when it desugars default and static
# interface methods: the jar of //prebuilts/studio/sdk:platforms/latest_jar.
_ANDROID_JAR = "@androidsdk//:platforms/android-34/android.jar"

# Compiles instrumenter_test_target to dex. d8 names its output classes.dex.
genrule(
    name = "instrumenter_test_target_dex",
    testonly = True,
    srcs = [
        ":instrumenter_test_target",
        _ANDROID_JAR,
    ],
    outs = ["classes.dex"],
    cmd = "$(execpath //prebuilts/r8:d8) --output $(RULEDIR)" +
          " --lib $(location %s)" % _ANDROID_JAR +
          " $(location :instrumenter_test_target)",
    tools = ["//prebuilts/r8:d8"],
)

# Converts the dex file to an array in a CC source file.
genrule(
    name = "instrumenter_test_target_dex_cc",
    testonly = True,
    srcs = [":instrumenter_test_target_dex"],
    outs = ["instrumenter_test_target_dex.cc"],
    cmd = "$(execpath //tools/base/bazel:bin2c) -lang=cxx" +
          " -variable=instrumenter_test_target_dex -output=$@ $(SRCS)",
    tools = ["//tools/base/bazel:bin2c"],
)

# The Kotlin class that instrumenter_test instruments with the real Kotlin
# filters. Its code is test data, so it isn't linted.
kotlin_library(
    name = "instrumenter_test_kotlin_target",
    testonly = True,
    srcs = ["testdata/com/example/InstrumenterTestKotlinTarget.kt"],
    kotlin_use_serialization = True,
    lint_enabled = False,
    deps = ["@maven//:org.jetbrains.kotlinx.kotlinx-serialization-core-jvm"],
)

# Compiles instrumenter_test_kotlin_target to dex, in a directory of its own
# since d8 names its output classes.dex. The libraries are on the classpath so
# that d8 can desugar the classes that implement their interfaces.
genrule(
    name = "instrumenter_test_kotlin_target_dex",
    testonly = True,
    srcs = [
        ":instrumenter_test_kotlin_target",
        _ANDROID_JAR,
        "@maven//:org.jetbrains.kotlin.kotlin-stdlib",
        "@maven//:org.jetbrains.kotlinx.kotlinx-serialization-core-jvm",
    ],
    outs = ["kotlin/classes.dex"],
    cmd = "$(execpath //prebuilts/r8:d8) --output $(RULEDIR)/kotlin" +
          " --lib $(location %s)" % _ANDROID_JAR +
          " --classpath $(location @maven//:org.jetbrains.kotlin.kotlin-stdlib)" +
          " --classpath $(location @maven//:org.jetbrains.kotlinx.kotlinx-serialization-core-jvm)" +
          " $(location :instrumenter_test_kotlin_target)",
    tools = ["//prebuilts/r8:d8"],
)

# Converts the dex file to an array in a CC source file.
genrule(
    name = "instrumenter_test_kotlin_target_dex_cc",
    testonly = True,
    srcs = [":instrumenter_test_kotlin_target_dex"],
    outs = ["instrumenter_test_kotlin_target_dex.cc"],
    cmd = "$(execpath //tools/base/bazel:bin2c) -lang=cxx" +
          " -variable=instrumenter_test_kotlin_target_dex -output=$@ $(SRCS)",
    tools = ["//tools/base/bazel:bin2c"],
)

cc_test(
    name = "instrumenter_test",
    size = "small",
    srcs = [
        "instrumenter_test.cc",
