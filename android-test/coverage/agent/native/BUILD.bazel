load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/base/bazel:android.bzl", "ANDROID_COPTS", "ANDROID_LINKOPTS", "android_cc_binary")

# Converts the jar containing runtime dex to an array in a CC source file.
genrule(
    name = "coverage_rt_cc_generator",
    srcs = [
        "//tools/base/android-test/coverage/agent/runtime:coverage_rt",
    ],
    outs = [
        "coverage_rt.cc",
    ],
    cmd = "$(location //tools/base/bazel:bin2c) -lang=cxx -variable=coverage_rt_jar" +
          " -output=$(location coverage_rt.cc)" +
          " $(location //tools/base/android-test/coverage/agent/runtime:coverage_rt)",
    tools = [
        "//tools/base/bazel:bin2c",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "agent_lib",
    srcs = [
        "hits_extractor.cc",
        "instrumenter.cc",
        "metadata_collector.cc",
    ],
    hdrs = [
        "hits_extractor.h",
        "instrumenter.h",
        "metadata_collector.h",
    ],
    copts = ANDROID_COPTS,
    deps = [
        "//prebuilts/studio/jdk:jni_headers",
        "//tools/base/android-test/coverage/common:log",
        "//tools/base/android-test/coverage/proto:coverage_metadata_cc_proto",
        "@slicer",
    ],
)

cc_binary(
    name = "coverage_agent.so",
    srcs = [
        "coverage_agent.cc",
        "coverage_rt.cc",
    ],
    copts = ANDROID_COPTS,
    linkopts = ANDROID_LINKOPTS,
    linkshared = 1,
    deps = [
        ":agent_lib",
    ],
)

android_cc_binary(
    name = "android_coverage_agent",
    binary = ":coverage_agent.so",
    filename = "coverage_agent.so",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "agent_unit_tests",
    size = "small",
    srcs = [
        "metadata_collector_test.cc",
    ],
    linkstatic = 1,
    deps = [
        ":agent_lib",
        "@googletest//:gtest_main",
    ],
)
