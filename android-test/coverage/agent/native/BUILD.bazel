load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("//tools/base/bazel:android.bzl", "ANDROID_COPTS", "ANDROID_LINKOPTS", "android_cc_binary", "jni_library")

# Converts the jar containing runtime dex to an array in a CC source file.
genrule(
    name = "coverage_rt_cc_generator",
    srcs = [
        "//tools/base/android-test/coverage/agent/runtime:coverage_tracker_dex",
    ],
    outs = [
        "coverage_rt.cc",
    ],
    cmd = "$(location //tools/base/bazel:bin2c) -lang=cxx -variable=coverage_rt_jar" +
          " -output=$(location coverage_rt.cc)" +
          " $(location //tools/base/android-test/coverage/agent/runtime:coverage_tracker_dex)",
    tags = ["testonly"],
    tools = [
        "//tools/base/bazel:bin2c",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "agent_lib",
    srcs = [
        "constructor_analyzer.cc",
        "hits_extractor.cc",
        "instrumenter.cc",
        "metadata_collector.cc",
        "parameter_shifter.cc",
        "register_scanner.cc",
        "synthetic_filter.cc",
    ],
    hdrs = [
        "constructor_analyzer.h",
        "hits_extractor.h",
        "instrumenter.h",
        "metadata_collector.h",
        "parameter_shifter.h",
        "register_scanner.h",
        "synthetic_filter.h",
    ],
    copts = ANDROID_COPTS,
    tags = ["testonly"],
    deps = [
        "//prebuilts/studio/jdk:jni_headers",
        "//tools/base/android-test/coverage/common:log",
        "//tools/base/build-system/gradle-core:coverage_metadata_cc_proto",
        "@slicer",
    ],
)

cc_binary(
    name = "coverage_agent.so",
    srcs = [
        "coverage_agent.cc",
        "coverage_rt.cc",
    ],
    copts = ANDROID_COPTS,
    linkopts = ANDROID_LINKOPTS,
    linkshared = 1,
    tags = ["testonly"],
    deps = [
        ":agent_lib",
    ],
)

android_cc_binary(
    name = "android_coverage_agent",
    binary = ":coverage_agent.so",
    filename = "coverage_agent.so",
    tags = ["testonly"],
    visibility = ["//visibility:public"],
)

jni_library(
    name = "coverage_agent_jni",
    tags = ["testonly"],
    visibility = ["//visibility:public"],
    deps = select({
        "//tools/base/bazel:without_vendor": [":placeholder"],
        "//conditions:default": [
            ":coverage_agent.so.stripped",
        ],
    }),
)

# Provide a non-empty target for environments where android_ndk_repository is not
# initialized (e.g. lightweight presubmits). This prevents build graph analysis
# failures while ensuring the resulting APK remains safe; the .txt file is
# ignored by the Android native loader, and the Java-side attacher handles the
# missing .so file gracefully without interrupting test execution.
genrule(
    name = "placeholder",
    outs = ["placeholder.txt"],
    cmd = "touch $@",
    tags = ["testonly"],
)

cc_test(
    name = "agent_unit_tests",
    size = "small",
    srcs = [
        "bytecode_helpers_test.cc",
        "hits_extractor_test.cc",
        "metadata_collector_test.cc",
    ],
    linkstatic = 1,
    deps = [
        ":agent_lib",
        "@googletest//:gtest_main",
    ],
)
