load("@rules_java//java:defs.bzl", "java_library")
load("//tools/base/bazel:android.bzl", "dex_library")
load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

# The actual hit recorder implementation.
java_library(
    name = "coverage_tracker_internal",
    srcs = ["src/main/java/com/android/tools/coverage/CoverageTracker.java"],
    visibility = ["//visibility:private"],
    deps = ["//tools/base/fakeandroid:android-mock"],
)

# A compile-only version of the tracker for other modules to link against.
java_library(
    name = "coverage_tracker_java",
    srcs = ["src/main/java/com/android/tools/coverage/CoverageTracker.java"],
    neverlink = 1,
    deps = ["//tools/base/fakeandroid:android-mock"],
)

# Published to gmaven as part of com.android.tools.test:coverage-agent, so it is
# built like every other released library: through kotlin_library, which
# compiles for the shared AGP jvm_target instead of the repo-wide
# --java_language_version.
kotlin_library(
    name = "coverage_rt_java",
    srcs = ["src/main/java/com/android/tools/coverage/CoverageAgentAttacher.java"],
    visibility = ["//tools/base/android-test/coverage/agent/support:__pkg__"],
    deps = [
        ":coverage_tracker_java",
        "//prebuilts/tools/common/m2:androidx-test-runner-1.4.0",
        "//tools/base/fakeandroid:android-mock",
        "@maven//:junit.junit",
    ],
)

# This is what the native agent embeds and injects into the BootClassLoader.
dex_library(
    name = "coverage_tracker_dex",
    jars = [":coverage_tracker_internal"],
    visibility = ["//tools/base/android-test/coverage/agent/native:__pkg__"],
)

java_test(
    name = "coverage_tracker_test",
    srcs = ["src/test/java/com/android/tools/coverage/CoverageTrackerTest.java"],
    test_class = "com.android.tools.coverage.CoverageTrackerTest",
    deps = [
        ":coverage_tracker_internal",
        "@maven//:junit.junit",
    ],
)

java_test(
    name = "coverage_agent_attacher_test",
    srcs = ["src/test/java/com/android/tools/coverage/CoverageAgentAttacherTest.java"],
    test_class = "com.android.tools.coverage.CoverageAgentAttacherTest",
    deps = [
        ":coverage_rt_java",
        "@maven//:junit.junit",
    ],
)
