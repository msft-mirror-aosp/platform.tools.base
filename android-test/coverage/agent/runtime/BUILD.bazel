load("@rules_java//java:defs.bzl", "java_library", "java_test")
load("//tools/base/bazel:android.bzl", "dex_library")

java_library(
    name = "coverage_rt_java",
    srcs = glob(["src/main/java/**/*.java"]),
)

java_test(
    name = "coverage_rt_test",
    srcs = glob(["src/test/java/**/*.java"]),
    test_class = "com.android.tools.coverage.CoverageTrackerTest",
    deps = [
        ":coverage_rt_java",
        "@maven//:junit.junit",
    ],
)

dex_library(
    name = "coverage_rt",
    jars = [":coverage_rt_java"],
    visibility = ["//visibility:public"],
)
