load("//tools/base/bazel:gradle.bzl", "gradle_build")
load("//tools/base/bazel:maven.bzl", "maven_repository")
load("//tools/base/bazel:utils.bzl", "merged_zip")
load("//tools/base/build-system:hybrid_build.bzl", "GRADLE_PROPERTIES")

filegroup(
    name = "agp_gradle_build_files",
    srcs = ["build.gradle"],
)

# keep sorted
UTP_SOURCE_FILES = [
    ":agp_gradle_build_files",
    "//tools:agp_gradle_build_files",
    "//tools/base/common:agp_gradle_build_files",
    "//tools/base/utp/gradle-work-action:agp_gradle_build_files",
    "//tools/base/utp/gradle-work-action-api:agp_gradle_build_files",
    "//tools/buildSrc:agp_gradle_build_files",
    "//tools/buildSrc/base:agp_gradle_build_files",
]

maven_repository(
    name = "utp_dependencies",
    # keep sorted
    artifacts = [
        "//tools/base/common:tools.common",
        "//tools/base/ddmlib:tools.ddmlib",
        "//tools/base/sdk-common:tools.sdk-common",
        "//tools/base/sdklib:tools.sdklib",
        "@maven//:com.android.tools.androidtest.android-test-engine",
        "@maven//:com.android.tools.androidtest.android-test-engine-result-listener",
        "@maven//:com.android.tools.androidtest.test-result-event-proto",
        "@maven//:com.android.tools.androidtest.test-result-proto",
        "@maven//:com.google.crypto.tink.tink_1.18.0",
        "@maven//:com.google.protobuf.protobuf-bom_4.28.3",
        "@maven//:com.google.protobuf.protobuf-java-util_4.28.3",
        "@maven//:com.google.protobuf.protobuf-java_4.28.3",
        "@maven//:org.junit.platform.junit-platform-engine",
        "@maven//:org.junit.platform.junit-platform-launcher",
    ],
)

gradle_build(
    name = "utp",
    build_file = "//tools:agp_gradle_build_root_build_file",
    data = ["//prebuilts/studio/jdk/jdk11:jdk_runtime_files"] + UTP_SOURCE_FILES,
    gradle_properties = GRADLE_PROPERTIES,
    output_file = "utp.zip",
    output_file_source = "dist/repo.zip",
    repos = [
        ":utp_dependencies",
        "//tools/base:agp_dependencies",
    ],
    tasks = [":base:utp:zipUtp"],
    visibility = [
        "//tools/base/gmaven:__pkg__",
    ],
)

merged_zip(
    name = "utp_maven_repo_for_integration_tests",
    testonly = 1,
    srcs = [
        ":utp.zip",
        ":utp_dependencies.zip",
    ],
    visibility = [
        "//tools/base/build-system/integration-test:__subpackages__",
        "//tools/vendor/google/android-ndk:__subpackages__",
        "//tools/vendor/google/lldb-integration-tests:__subpackages__",
        "//tools/vendor/google/ml:__subpackages__",
    ],
)
