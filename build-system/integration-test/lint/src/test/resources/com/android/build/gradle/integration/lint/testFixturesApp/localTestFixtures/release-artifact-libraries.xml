      name="org.jetbrains.kotlin:kotlin-stdlib:${kotlinVersion}@jar"
      jars="${mavenRepo}/org/jetbrains/kotlin/kotlin-stdlib/${kotlinVersion}/kotlin-stdlib-${kotlinVersion}.jar"
      resolved="org.jetbrains.kotlin:kotlin-stdlib:${kotlinVersion}"/>
  <library
      name=":@@:javaLib"
