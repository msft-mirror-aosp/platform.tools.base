      resolved="::"/>
  <library
      name="org.jetbrains:annotations:13.0@jar"
      jars="${mavenRepo}/org/jetbrains/annotations/13.0/annotations-13.0.jar"
      resolved="org.jetbrains:annotations:13.0"/>
</libraries>
