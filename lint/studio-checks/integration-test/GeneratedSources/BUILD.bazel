load("//tools/base/bazel:expand_template.bzl", "expand_template")
load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

# Generated sources live under bazel-out/ in the execroot, not next to their package. The
# analyze actions record their locations at analyze time; the reporting test must find the
# same files (both the dependency's, whose partial results are merged, and the tested
# module's own, in which a finding is reported) at report time.

expand_template(
    name = "generated_lib",
    out = "lib/test/gen/lib/GeneratedLib.kt",
    substitutions = {"{FUNCTION}": "generatedDoStuff"},
    template = "lib/test/gen/lib/GeneratedLib.kt.template",
)

# (Single-pass mode cannot lint generated sources at all: its descriptor names them by
# execroot path but its runfiles lay them out by short path.)
kotlin_library(
    name = "lib",
    srcs = [":generated_lib"],
    lint_partial_analysis = True,
    deps = ["//tools/base/annotations"],
)

expand_template(
    name = "generated_consumer",
    out = "consumer/test/gen/consumer/GeneratedConsumer.kt",
    substitutions = {"{FUNCTION}": "generatedDoStuff"},
    template = "consumer/test/gen/consumer/GeneratedConsumer.kt.template",
)

kotlin_library(
    name = "consumer",
    srcs = [
        "consumer/test/gen/consumer/Consumer.kt",
        ":generated_consumer",
    ],
    lint_baseline = "consumer/ConsumerBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":lib",
        "//tools/base/annotations",
    ],
)
