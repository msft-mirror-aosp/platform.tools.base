load("@rules_java//java:defs.bzl", "java_library")
load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

# A neverlink dependency is only on the compile-time classpath. Analysis must see it
# (both to resolve the directly annotated call and to merge the inferred annotation of a
# module lint reaches through the compile-time classpath only).

java_library(
    name = "api",
    srcs = ["api/test/neverlink/api/Api.java"],
    neverlink = True,
    deps = ["//tools/base/annotations"],
)

kotlin_library(
    name = "consumer",
    srcs = ["consumer/test/neverlink/consumer/Consumer.kt"],
    lint_baseline = "consumer/ConsumerBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":api",
        "//tools/base/annotations",
    ],
)
