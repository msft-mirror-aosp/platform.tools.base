load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

# Library with its own lint issue, baselined in LibBaseline.xml.
# Partial analysis writes lint-definite.xml for :lib during its analysis action.
kotlin_library(
    name = "lib",
    srcs = ["lib/test/depissue/lib/LibWithIssue.kt"],
    lint_baseline = "lib/LibBaseline.xml",
    lint_partial_analysis = True,
    deps = ["//tools/base/annotations"],
)

# Consumer library depending on :lib.
# Verifies that BazelLintWrapper filters out :lib's lint-definite.xml when copying
# dependency partial state, ensuring :lib's issue is not re-reported in consumer_lint_test.
kotlin_library(
    name = "consumer",
    srcs = ["consumer/test/depissue/consumer/Consumer.kt"],
    lint_baseline = "consumer/ConsumerBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":lib",
        "//tools/base/annotations",
    ],
)
