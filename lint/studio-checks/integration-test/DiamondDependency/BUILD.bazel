load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

kotlin_library(
    name = "base",
    srcs = ["base/test/diamond/base/Base.kt"],
    deps = ["//tools/base/annotations"],
)

kotlin_library(
    name = "left",
    srcs = ["left/test/diamond/left/Left.kt"],
    deps = [":base"],
)

kotlin_library(
    name = "right",
    srcs = ["right/test/diamond/right/Right.kt"],
    deps = [":base"],
)

# Diamond dependency: top depends on left and right, both of which depend on base.
# Verifies partial analysis aspect traversal and BazelLintWrapper descriptor handling
# on diamond dependency graphs.
kotlin_library(
    name = "top",
    srcs = ["top/test/diamond/top/Top.kt"],
    lint_baseline = "top/TopBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":left",
        ":right",
        "//tools/base/annotations",
    ],
)
