load("@rules_java//java:defs.bzl", "java_import")
load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

# lint_classpath names modules lint should analyze that are not reachable through the
# library's deps/exports (lint_test's partial_deps). Here :lib only reaches :consumer as a
# jar (java_import has no sources the aspect can analyze), so its inferred @UiThread is
# only known when :lib itself is listed on lint_classpath.

kotlin_library(
    name = "lib",
    srcs = ["lib/test/pdeps/lib/Lib.kt"],
    deps = ["//tools/base/annotations"],
)

java_import(
    name = "lib_jar",
    jars = [":liblib.jar"],
)

# Without lint_classpath: only the call to the locally annotated function is reported.
kotlin_library(
    name = "consumer_without",
    srcs = ["consumer/test/pdeps/consumer/Consumer.kt"],
    lint_baseline = "consumer/LocalOnly.xml",
    lint_partial_analysis = True,
    deps = [
        ":lib_jar",
        "//tools/base/annotations",
    ],
)

# With lint_classpath: :lib is analyzed too and its inferred @UiThread is reported.
kotlin_library(
    name = "consumer_with",
    srcs = ["consumer/test/pdeps/consumer/Consumer.kt"],
    lint_baseline = "consumer/WithLib.xml",
    lint_classpath = [":lib"],
    lint_partial_analysis = True,
    deps = [
        ":lib_jar",
        "//tools/base/annotations",
    ],
)
