load("//tools/base/bazel:kotlin.bzl", "kotlin_library")
load("//tools/base/bazel:maven.bzl", "maven_library")

licenses(["notice"])

maven_library(
    name = "core_maven",
    srcs = ["core/test/exports/core/Core.kt"],
    coordinates = "com.example.test:core-maven:1.0.0",
    deps = [
        "//tools/base/annotations",
        "@maven//:org.jetbrains.kotlin.kotlin-stdlib",
    ],
)

# Exporter maven_library using exports = [":core_maven"] to verify aspect propagation over exports.
maven_library(
    name = "exporter",
    srcs = [],
    coordinates = "com.example.test:exporter:1.0.0",
    exports = [":core_maven"],
)

# Maven library wrapping a kotlin_library to verify aspect propagation through the library attr.
# Exports :exporter so transitively exported symbols in core_maven are reachable by consumer.
maven_library(
    name = "maven_wrapper",
    srcs = ["maven/test/exports/maven/MavenWrapper.kt"],
    coordinates = "com.example.test:maven-wrapper:1.0.0",
    exports = [":exporter"],
    deps = [
        "//tools/base/annotations",
        "@maven//:org.jetbrains.kotlin.kotlin-stdlib",
    ],
)

# Consumer lint test targeting maven_wrapper (which transitively exports core_maven).
kotlin_library(
    name = "consumer",
    srcs = ["consumer/test/exports/consumer/Consumer.kt"],
    lint_baseline = "consumer/ConsumerBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":maven_wrapper",
        "//tools/base/annotations",
    ],
)
