load("@rules_java//java:defs.bzl", "java_library")
load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

# Java sources: a native java_library dependency is analyzed by the aspect like any other
# module, and a lint test's own module can mix Java and Kotlin sources.

java_library(
    name = "lib",
    srcs = ["lib/test/javasrc/lib/JavaLib.java"],
    deps = ["//tools/base/annotations"],
)

kotlin_library(
    name = "consumer",
    srcs = [
        "consumer/test/javasrc/consumer/JavaConsumer.java",
        "consumer/test/javasrc/consumer/KotlinConsumer.kt",
    ],
    lint_baseline = "consumer/ConsumerBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":lib",
        "//tools/base/annotations",
    ],
)
