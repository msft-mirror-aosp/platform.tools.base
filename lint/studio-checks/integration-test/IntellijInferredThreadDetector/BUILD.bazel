load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

kotlin_library(
    name = "lib",
    srcs = ["LibAnnotated.kt"],
    deps = ["//tools/base/annotations"],
)

# Linted with partial analysis: :lib is analyzed as its own module, so its recorded
# @UiThread state is visible here and BOTH WrongThread errors in Consumer.kt are found,
# just like in :both. Without partial analysis, the cross-module call to doStuff() is
# missed and only one error is reported.
kotlin_library(
    name = "consumer",
    srcs = ["Consumer.kt"],
    lint_baseline = "ConsumerBoth.xml",
    lint_partial_analysis = True,
    deps = [
        ":lib",
        "//tools/base/annotations",
    ],
)

# Negative control test: linted without partial analysis (single-pass mode).
# In single-pass mode, the cross-module call to doStuff() is missed, so only
# the local WrongThread error for doOtherStuff() is reported.
kotlin_library(
    name = "consumer_single_pass",
    srcs = ["Consumer.kt"],
    lint_baseline = "ConsumerSinglePass.xml",
    lint_partial_analysis = False,
    deps = [
        ":lib",
        "//tools/base/annotations",
    ],
)

kotlin_library(
    name = "both",
    srcs = [
        "Consumer.kt",
        "LibAnnotated.kt",
    ],
    lint_baseline = "ContainsBoth.xml",
    deps = [
        "//tools/base/annotations",
    ],
)
