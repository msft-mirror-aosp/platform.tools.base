load("@rules_java//java:defs.bzl", "java_library")
load("//tools/base/bazel:kotlin.bzl", "kotlin_library")

licenses(["notice"])

# The external annotations (tools/base/external-annotations, e.g. IntelliJ SDK threading
# annotations) are part of every analysis lint_partial_aspect registers, whether or not the
# lint test passes them: kotlin_library lint tests do not, so this call to the (stubbed)
# @UiThread Application.runWriteAction is only reported with partial analysis.

java_library(
    name = "stubs",
    srcs = [
        "stubs/com/intellij/openapi/application/Application.java",
        "stubs/com/intellij/openapi/util/Computable.java",
    ],
)

kotlin_library(
    name = "consumer",
    srcs = ["consumer/test/extann/consumer/Consumer.kt"],
    lint_baseline = "consumer/ConsumerBaseline.xml",
    lint_partial_analysis = True,
    deps = [
        ":stubs",
        "//tools/base/annotations",
    ],
)

# Single-pass control: no external annotations, nothing reported.
kotlin_library(
    name = "consumer_single_pass",
    srcs = ["consumer/test/extann/consumer/Consumer.kt"],
    lint_baseline = "consumer/ConsumerSinglePass.xml",
    lint_partial_analysis = False,
    deps = [
        ":stubs",
        "//tools/base/annotations",
    ],
)
