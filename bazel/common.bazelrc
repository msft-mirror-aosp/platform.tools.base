# Enables the use of native symlinks in worker sandboxes,
# required for dynamic scheduling. This has no effect on non-windows platforms.
startup --windows_enable_symlinks

# Platform specific config automatically applies --config=(linux|macos|windows)
common --enable_platform_specific_config

# Remote Build Execution requires a strong hash function, such as SHA256.
startup --host_jvm_args=-Dbazel.DigestFunction=SHA256

# Building runfile trees is unnecessary, unless executing binaries in bazel-bin/ manually (use 'bazel run' instead)
# See: https://github.com/bazelbuild/bazel/commit/03246077f948f2790a83520e7dccc2625650e6df
common --nobuild_runfile_links

# An always true definition, to be able to force config_setting rules
common --define=always_true=true

# Enforces UTF-8 encoding in bazel tests.
common --test_env='LC_ALL=en_US.UTF-8'
common --jvmopt='-Dsun.jnu.encoding=UTF-8'
common --jvmopt='-Dfile.encoding=UTF-8'
common --jvmopt='-Xmx4G'
common --jvmopt='-XX:+UseG1GC'
common --jvmopt='-XX:+ErrorFileToStderr'
common --verbose_failures

common --noincompatible_disallow_empty_glob
# TODO(b/416777191) PerfgateDataCollector relies on zipped test outputs.
common --zip_undeclared_test_outputs

# Needed by rules_android.
common --experimental_google_legacy_api
common --experimental_enable_android_migration_apis

# Needed by rules_python.
# This flag will become the default soon; we set it now to avoid warnings during the build.
# See https://github.com/bazel-contrib/rules_python/issues/2945 for details.
common --incompatible_default_to_explicit_init_py

# Exposes artifacts to Sponge.
common --legacy_important_outputs

# TypeScript support: aspect_rules_ts requires every workspace to explicitly declare
# its skipLibCheck strategy in .bazelrc. "honor_tsconfig" means respecting whatever
# skipLibCheck setting is configured inside each package's local tsconfig.json file.
common --@aspect_rules_ts//ts:skipLibCheck=honor_tsconfig

# Configure PIE linkmode for compatibility with clang toolchain.
common --@rules_go//go/config:linkmode=pie

# JetBrainsRuntime version to bundle into Android Studio
# and java runtime for running tests
common:jbr25 --//prebuilts/studio/jdk:jdk_bundle_version=25
common:jbr25 --java_runtime_version=jbr25

# Enable Kotlin K2 mode (b/373746515).
common --jvmopt='-Didea.kotlin.plugin.use.k1=false'
# Enable K2 UAST by default (b/448273436)
common --jvmopt='-Dlint.use.fir.uast=true'

# Local runs require longer timeouts.
common:local --test_timeout=120,600,1800,7200

# Don't use JUnit from Bazel.
common --explicit_java_test_deps

# Tests depend on not having a real user name, but bazel now returns the
# real one. This flag keeps the old behavior of not having a home directory.
common --sandbox_fake_username

# The --sandbox_fake_username option changes the user to "nobody".
# This causes tests that rely on HOME (e.g., those using adb) to fail.
# Explicitly set HOME="$TEST_TMPDIR" to ensure these tests can run.
common --test_env=HOME="$TEST_TMPDIR"

common:ignored --jvmopt=-Dignored.tests.only=true

# Attach aspects for validation of targets
common --aspects=tools/base/bazel/validations/timeout.bzl%no_eternal_tests
common --aspects=tools/base/bazel/validations/flaky.bzl%limit_flaky_tests
common --aspects=tools/base/bazel/validations/py2.bzl%no_py2_targets
# Generates a ${TARGET}.datasize.txt output which shows the size of data
# dependencies for each target. See the aspect definition for more.
common:datasize_aspect --aspects=tools/base/bazel/validations/size.bzl%data_size
common:datasize_aspect --output_groups=+data_size

common --incompatible_strict_action_env # Ensures actions don't pick up env changes
# TODO (b/141269926): this generates a warning on windows when building for host,
# but is required when building for android.
common --copt=-fvisibility=hidden

common --define=grpc_no_ares=true

# Bazel will find the matching java toolchain registered in bzlmod/toolchains.MODULE.bazel
## Java version for build tools
common --tool_java_language_version=25
common --tool_java_runtime_version=jbr25
## Java version for compiling source code (javac)
common --java_language_version=25
## Java version for running tests and targets (java)
common --java_runtime_version=jbr25
## JetBrainsRuntime version to bundle into Android Studio
common --//prebuilts/studio/jdk:jdk_bundle_version=25
common --jvmopt='-Dembedded.jdk.path=prebuilts/studio/jdk/jbr25'

common --stripopt=--strip-unneeded

# Do not register auto-generated cpp toolchains
common --repo_env='BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1'

# Use protobuf toolchain resolution.
common --incompatible_enable_proto_toolchain_resolution
# Disable one_output_per_message, which has problem with virtual imports
common --features=-proto_one_output_per_message

# default android native abis
# LINT.IfChange(android_platforms)
common --android_platforms=@rules_android//:x86,@rules_android//:x86_64,@rules_android//:armeabi-v7a,@rules_android//:arm64-v8a
# LINT.ThenChange(/bazel/android.bzl:android_platforms)

# Auto load some rules that are no longer built-in with bazel 9
# Migrate away before updating to bazel 10
common --incompatible_autoload_externally=+@rules_cc,+@rules_java,+py_runtime,+py_library,+py_binary,+py_test,+sh_library,+sh_binary,+sh_test,+proto_library,+ProtoInfo,+java_proto_library,+cc_proto_library,+java_lite_proto_library
common --noincompatible_disable_autoloads_in_main_repo

## Options to make bazel less memory/cpu intensive.
## Recommended to use with rcache config to avoid building outputs already
## present in the remote cache.
common:nice --worker_max_instances=1
common:nice --jobs=HOST_CPUS*.5

# Optimize c/c++ compilation.
# See opt_feature in build/bazel/toolchains/cc/*/features.bzl
# to see flags added in opt mode.
common:release -c opt
common:release --strip=always
common:release --@rules_rust//rust/settings:lto=fat
common:release --//tools/base/bazel:studio-release
# Disable Clang diagnostics for release builds, to reduce the amount of noise
# # in the output in continuous builds and --config=remote runs.
common:release --copt=-w

## Base RBE configuration
startup --experimental_remote_repo_contents_cache
common:_remote_base --bes_timeout=240s
common:_remote_base --grpc_keepalive_time=30s
common:_remote_base --build_event_upload_max_retries=10
common:_remote_base --remote_cache=remotebuildexecution.googleapis.com
common:_remote_base --remote_instance_name=projects/google.com:android-studio-alphasource/instances/default_instance
# Input file attribute affects the output of zipper. It should always run
# locally (b/198297058#comment42)
common:_remote_base --strategy=zipper=local

# Publish to the private BES backend.
common:sponge --bes_keywords=android-devtools
common:sponge --bes_backend=buildeventservice-pa.googleapis.com
common:sponge --bes_results_url=https://fusion2.corp.google.com/invocations/

# Enable go/antswatcher to process test results.
# This config must be used with the sponge config as it relies on the same bes_backend.
# NOTE: Bazel invocations must still supply --build_metadata values for ab_target and ab_build_id
# to be create a successful AnTS result.
common:ants --bes_keywords=android-test-storage
common:ants --build_metadata="test_definition_name=android_studio/bazel"
common:ants --build_metadata=generate_test_uri=fusion
common:ants --build_metadata=run_type=critical
common:ants --bes_keywords=antswatcher:skip_tests_if_timeout
common:ants --bes_keywords=antswatcher:use_dependent_jobs
common:ants --bes_keywords=antswatcher:android_module_behavior
common:ants --bes_keywords=antswatcher:enable_resultdb

## Base config for using the remote cache.
## This avoids building things which were already built by CI.
common:_rcache --config=_remote_base
common:_rcache --noremote_upload_local_results
# remote_local_fallback allows bazel to continue if there are
# network connectivity failures (e.g., offline)
common:_rcache --remote_local_fallback
# NOWAIT_FOR_UPLOAD_COMPLETE speeds up bazel slightly by returning when the
# build is complete, not when BES upload finishes.
# This improves offline use cases as well, otherwise bazel does not complete
# until the BES upload times out (10 seconds).
common:_rcache --bes_upload_mode=NOWAIT_FOR_UPLOAD_COMPLETE

## Enables the remote cache and uploading to Sponge.
## This config should be commonly used to avoid building outputs that
## already exist in the cache.
common:rcache --config=_rcache
common:rcache --config=sponge

## Enables the remote cache, but without uploading to Sponge (for hosts with
## poor uplink).
common:rcache_no_sponge --config=_rcache

## Enables remote execution so actions are performed on the remote systems.
common:remote-exec --remote_executor=remotebuildexecution.googleapis.com
common:remote-exec --remote_timeout=3600
common:remote-exec --show_timestamps
# Depending on how many machines are in the remote execution instance, setting
# this higher can make builds faster by allowing more jobs to run in parallel.
# Setting it too high can result in jobs that timeout, however, while waiting
# for a remote machine to execute them.
common:remote-exec --jobs=350

## Remote combines all the configs used for remote execution.
common:remote --config=_remote_base
common:remote --config=remote-exec
common:remote --config=sponge

common:dl-staging --downloader_config=tools/base/bazel/ci/data/downloader-staging.cfg
common:dl-ci --downloader_config=tools/base/bazel/ci/data/downloader.cfg

## Config used for continous integration testing scripts.
# The downloader.cfg requires a --credential_helper for certain domains, and
# is added by tools/base/bazel/ci/ci and ci.cmd scripts.
common:ci --config=dl-ci
common:ci --google_default_credentials
common:ci --config=_remote_base
# Enables pre-computed test fixtures (e.g. Emulator Snapshots).
# - Expensive runtime operations are shifted to the build stage and converted into fixtures.
# - Caches the resulting artifacts on RBE for global reuse across the team.
# - Dramatically improves test performance and determinism.
common:prebuild_test_fixtures --//tools/adt/idea/emulator-snapshots:enable_snapshots=True

# Optimization: CI/CD runs always use prebuilt fixtures to reduce latency and compute costs.
common:ci --config=prebuild_test_fixtures
common:ci --config=sponge
common:ci --config=release
common:ci --//tools/base/bazel/ci:is_ci
# Increase worker visibility in case there are issues.
common:ci --worker_verbose
# Prevents b/156952249. Android Build (buildbot) kills bazel between builds,
# so there is no need to keep workers alive after the build.
common:ci --worker_quit_after_build
# The CI runs a lot of targets and when they are all cached the BES upload
# may take a long time.
common:ci --bes_timeout=1200s
# Capture network stats in CI runs.
common:ci --experimental_collect_system_network_usage
# Limit the progress avoid spammy build logs.
common:ci --show_progress_rate_limit=60
# Avoid incompatible targets when targets are set explicitly with selective
# presubmit.
common:ci --skip_incompatible_explicit_targets
common:ci --strategy=Javac=worker
common:ci --strategy=kotlinc=worker
common:ci --strategy=Turbine=local
# Verify lockfile for CI runs.
common:ci --lockfile_mode=error
# Upload artifacts to RBE cache.
common:ci --remote_build_event_upload=all

## Enables dynamic scheduling. This will run some actions locally
## as well as remotely, choosing whichever finishes first.
common:dynamic --config=remote-exec
common:dynamic --internal_spawn_scheduler
common:dynamic --strategy=Javac=dynamic
common:dynamic --strategy=kotlinc=dynamic
common:dynamic --strategy=formc=dynamic
common:dynamic --strategy=singlejar=dynamic
common:dynamic --strategy=MergedZip=dynamic
common:dynamic --strategy=CreateJvmCompileJar=dynamic
# Configure auxiliary java mnemonics to run dynamically
common:dynamic --strategy=JavaIjar=dynamic
common:dynamic --strategy=JavaDeployJar=dynamic
common:dynamic --strategy=JavaSourceJar=dynamic
common:dynamic --strategy=Turbine=dynamic
common:dynamic --strategy=JavacTurbine=dynamic
# Studio build actions, see b/171900265 for details
common:dynamic --strategy=zipmerger=dynamic
common:dynamic --strategy=chkplugin=dynamic
common:dynamic --strategy=stamper=dynamic
common:dynamic --strategy=PythonZipper=dynamic
# Multiplex workers are not sandboxed, and are not ready to be used with
# dynamic scheduling.
common:dynamic --noexperimental_worker_multiplex

# Lockfile includes deps that are not available when building without vendor
# so we disable checking.
common:without_vendor --lockfile_mode=off
common:without_vendor --//tools/base/bazel:without-vendor

# Build arguments for IntelliJ Platform targets (@tools_idea//...).
common --@tools_idea_rules_jvm//:default-kotlinc-opts=@tools_idea//:k25
common --strategy=JvmCompile=worker
common --strategy=HavenCli=worker
