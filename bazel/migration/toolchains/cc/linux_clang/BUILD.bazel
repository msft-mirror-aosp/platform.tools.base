load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(
    "//tools/base/bazel/migration/toolchains/cc:rules.bzl",
    "cc_toolchain_config",
    "cc_toolchain_dynamic_runtime",
    "cc_toolchain_static_runtime",
)
load(":features.bzl", "cc_features")

package(default_visibility = ["//visibility:public"])

_x64_imports = [
    "@clang_linux_x64//:libcxx",
    "@clang_linux_x64//:compiler_rt",
    "@clang_linux_x64//:libunwind",
] + select({
    ":host_stdlibs": [],
    "//conditions:default": [
        "@gcc_lib//:start_libs",
        "@gcc_lib//:libs",
    ],
})

config_setting(
    name = "host_stdlibs",
    values = {"features": "-no_implicit_libs"},
)

cc_features(
    name = "x64_features",
    b_prefix = select({
        ":host_stdlibs": None,
        "//conditions:default": "@gcc_lib//:lib/gcc/x86_64-linux/4.8.3",
    }),
    compile_flags = [
        "--target=x86_64-unknown-linux-gnu",
        "-no-canonical-prefixes",
        "-Wno-builtin-macro-redefined",
        "-D__DATE__=\"redacted\"",
        "-D__TIMESTAMP__=\"redacted\"",
        "-D__TIME__=\"redacted\"",
        "-Wall",
        "-Wthread-safety",
        "-fstack-protector-strong",
        "-fcolor-diagnostics",
    ],
    cxx_flags = [
        "-std=c++17",
        "-nostdinc++",
    ],
    link_flags = [
        "--target=x86_64-unknown-linux-gnu",
        "-fuse-ld=lld",
        "-rtlib=compiler-rt",
        "-Wno-unused-command-line-argument",
        "-Wl,--as-needed",
        "-lm",
        "-ldl",
        "-Wl,--no-as-needed",
        "-l:libunwind.a",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    toolchain_imports = _x64_imports,
)

cc_toolchain_config(
    name = "x64_config",
    cc_features = ":x64_features",
    cc_tools = [
        "@clang_linux_x64//:clang",
        "@clang_linux_x64//:archiver",
        "@clang_linux_x64//:strip",
    ],
    compiler_name = "clang",
    identifier = "linux_clang_x64",
    legacy_builtin_include_directories = select({
        ":host_stdlibs": [
            "/usr/include",
            "/usr/include/x86_64-linux-gnu",
        ],
        "//conditions:default": [],
    }),
    sysroot = select({
        ":host_stdlibs": None,
        "//conditions:default": "@gcc_lib//:sysroot",
    }),
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    target_cpu = "k8",
    toolchain_imports = _x64_imports,
)

cc_toolchain_dynamic_runtime(
    name = "x64_dynamic_runtime",
    libs = _x64_imports,
    target_compatible_with = [
        "@platforms//os:linux",
    ],
)

cc_toolchain_static_runtime(
    name = "x64_static_runtime",
    libs = _x64_imports,
    target_compatible_with = [
        "@platforms//os:linux",
    ],
)

cc_toolchain(
    name = "x64",
    all_files = ":x64_config",
    ar_files = "@clang_linux_x64//:archiver",
    as_files = "@clang_linux_x64//:clang",
    compiler_files = ":x64_config",
    dwp_files = "//tools/base/bazel/migration/toolchains/cc:empty",
    dynamic_runtime_lib = ":x64_dynamic_runtime",
    linker_files = ":x64_config",
    objcopy_files = "//tools/base/bazel/migration/toolchains/cc:empty",
    static_runtime_lib = ":x64_static_runtime",
    strip_files = "@clang_linux_x64//:strip",
    supports_param_files = 1,
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    toolchain_config = ":x64_config",
)

toolchain(
    name = "x64_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":x64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)

# Cross-compiling toolchain targeting Linux ARM64, from Linux x86_64.
#
# Clang and lld are inherently cross-compilers, so we reuse the host prebuilts. The target
# libraries (glibc, libgcc) come from a Debian arm64 sysroot, since our clang prebuilt does not
# ship aarch64-unknown-linux-gnu runtimes. Consequently this toolchain uses libgcc rather than
# compiler-rt, and does not provide a C++ standard library (currently only C and Rust
# code are built for this target). Clang derives all include and library paths from --sysroot.
#
# Note: this was originally added in a rush to support Android CLI on Googlebooks (b/549892162).
# We don't know yet if it's suitable beyond that purpose.
cc_features(
    name = "arm64_features",
    compile_flags = [
        "--target=aarch64-unknown-linux-gnu",
        "-no-canonical-prefixes",
        "-Wno-builtin-macro-redefined",
        "-D__DATE__=\"redacted\"",
        "-D__TIMESTAMP__=\"redacted\"",
        "-D__TIME__=\"redacted\"",
        "-Wall",
        "-Wthread-safety",
        "-fstack-protector-strong",
        "-fcolor-diagnostics",
    ],
    cxx_flags = [
        "-nostdinc++",
    ],
    link_flags = [
        "--target=aarch64-unknown-linux-gnu",
        "-fuse-ld=lld",
        "-Wno-unused-command-line-argument",
        "-Wl,--as-needed",
        "-lm",
        "-ldl",
        "-Wl,--no-as-needed",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    toolchain_imports = ["@clang_linux_x64//:builtin_headers"],
)

cc_toolchain_config(
    name = "arm64_config",
    cc_features = ":arm64_features",
    cc_tools = [
        "@clang_linux_x64//:clang",
        "@clang_linux_x64//:archiver",
        "@clang_linux_x64//:strip",
    ],
    compiler_name = "clang",
    identifier = "linux_clang_arm64",
    sysroot = "@sysroot_linux_arm64//:sysroot",
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    target_cpu = "aarch64",
    toolchain_imports = ["@clang_linux_x64//:builtin_headers"],
)

cc_toolchain(
    name = "arm64",
    all_files = ":arm64_config",
    ar_files = "@clang_linux_x64//:archiver",
    as_files = "@clang_linux_x64//:clang",
    compiler_files = ":arm64_config",
    dwp_files = "//tools/base/bazel/migration/toolchains/cc:empty",
    # The clang driver links the runtime libraries (glibc, libgcc) from the sysroot itself.
    dynamic_runtime_lib = "//tools/base/bazel/migration/toolchains/cc:empty",
    linker_files = ":arm64_config",
    objcopy_files = "//tools/base/bazel/migration/toolchains/cc:empty",
    static_runtime_lib = "//tools/base/bazel/migration/toolchains/cc:empty",
    strip_files = "@clang_linux_x64//:strip",
    supports_param_files = 1,
    target_compatible_with = [
        "@platforms//os:linux",
    ],
    toolchain_config = ":arm64_config",
)

toolchain(
    name = "arm64_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "@bazel_tools//tools/cpp:clang",
    ],
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    toolchain = ":arm64",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
