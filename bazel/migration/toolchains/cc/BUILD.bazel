load("@bazel_skylib//rules:common_settings.bzl", "bool_setting")
load(":bootstrap.bzl", "cc_bootstrap_binary")

filegroup(
    name = "empty",
    srcs = [],
    visibility = ["//tools/base/bazel/migration/toolchains/cc:__subpackages__"],
)

bool_setting(
    name = "bootstrap",
    build_setting_default = False,
)

config_setting(
    name = "is_bootstrap",
    flag_values = {
        ":bootstrap": "true",
    },
    visibility = [
        "//tools/base/bazel/migration/toolchains/cc:__subpackages__",
        "@clang_mac_all//:__subpackages__",
    ],
)

cc_bootstrap_binary(
    name = "wrapper",
    srcs = ["wrapper.cc"],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["@clang_mac_all//:__subpackages__"],
)
