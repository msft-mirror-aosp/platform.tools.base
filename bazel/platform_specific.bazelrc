#
# Linux
#
common:linux --credential_helper=chrome-infra-packages.appspot.com=%workspace%/build/bazel/tools/credhelper
common:linux --credential_helper=storage.googleapis.com=%workspace%/build/bazel/tools/credhelper
common:linux --credential_helper=*.pkg.dev=%workspace%/build/bazel/tools/credhelper
common:linux --credential_helper_timeout=60s
common:linux --bes_keywords=linux
common:linux --host_platform=//tools/base/bazel/platforms:linux
common:linux --platforms=//tools/base/bazel/platforms:linux
# Block network by default on linux
common:linux --nosandbox_default_allow_network
common:linux --dynamic_local_strategy=worker,sandboxed,local
common:linux --workspace_status_command="prebuilts/python/linux-x86/bin/python3 tools/base/bazel/workspace.py"

#
# Windows
#
common:windows --credential_helper=chrome-infra-packages.appspot.com=%workspace%/build/bazel/tools/credhelper.cmd
common:windows --credential_helper=storage.googleapis.com=%workspace%/build/bazel/tools/credhelper.cmd
common:windows --credential_helper=*.pkg.dev=%workspace%/build/bazel/tools/credhelper.cmd
common:windows --credential_helper_timeout=60s

common:windows --bes_keywords=windows
common:windows --host_platform=//tools/base/bazel/platforms:windows
common:windows --platforms=//tools/base/bazel/platforms:windows
common:windows --shell_executable=C:\\tools\\msys64\\usr\\bin\\bash.exe
# Needed to build the latest version of @com_google_protobuf//:protoc
common:windows --host_linkopt=/DEFAULTLIB:libcmt.lib
# Runfiles is off by default for Windows, enable it.
common:windows --enable_runfiles
# Static link native artifacts
common:windows --features=static_link_msvcrt
# Windows only supports worker,local strategies, sandboxed not supported.
common:windows --dynamic_local_strategy=worker,local
# Workaround for b/277781554 where bazel fails to clean up python zips
common:windows --nobuild_python_zip
common:windows --workspace_status_command="tools/base/bazel/workspace.cmd"

#
# Mac
#
common:macos --credential_helper=chrome-infra-packages.appspot.com=%workspace%/build/bazel/tools/credhelper
common:macos --credential_helper=storage.googleapis.com=%workspace%/build/bazel/tools/credhelper
common:macos --credential_helper=*.pkg.dev=%workspace%/build/bazel/tools/credhelper
common:macos --credential_helper_timeout=60s

# supports_dynamic_linker cannot be used on MacOS, or will cause thread-local
# failures in protobuf. Other libraries (grpc) have encountered this issue,
# see https://github.com/bazelbuild/bazel/issues/4341.
common:macos --features=-supports_dynamic_linker
common:macos --bes_keywords=macos
common:macos --host_platform=//tools/base/bazel/platforms:macos
common:macos --platforms=//tools/base/bazel/platforms:macos
common:macos --watchfs
common:macos --workspace_status_command="prebuilts/python/darwin-x86/bin/python3 tools/base/bazel/workspace.py"
