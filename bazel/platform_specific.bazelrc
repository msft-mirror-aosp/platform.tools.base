#
# Linux
#
common:linux --repo_env=ANDROID_NDK_HOME=$WORKSPACE_ROOT/prebuilts/studio/sdk/linux/ndk/28.2.13676358
common:linux --credential_helper=chrome-infra-packages.appspot.com=%workspace%/build/bazel/tools/credhelper
common:linux --credential_helper=storage.googleapis.com=%workspace%/build/bazel/tools/credhelper
common:linux --credential_helper=*.pkg.dev=%workspace%/build/bazel/tools/credhelper
build:linux --bes_keywords=linux
build:linux --host_platform=//tools/base/bazel/platforms:linux
build:linux --platforms=//tools/base/bazel/platforms:linux
# Block network by default on linux
build:linux --nosandbox_default_allow_network
build:linux --dynamic_local_strategy=worker,sandboxed,local
build:linux --workspace_status_command="prebuilts/python/linux-x86/bin/python3 tools/base/bazel/workspace.py"

#
# Windows
#
common:windows --repo_env=ANDROID_NDK_HOME=$WORKSPACE_ROOT/prebuilts/studio/sdk/windows/ndk/28.2.13676358
common:windows --credential_helper=chrome-infra-packages.appspot.com=%workspace%/build/bazel/tools/credhelper.cmd
common:windows --credential_helper=storage.googleapis.com=%workspace%/build/bazel/tools/credhelper.cmd
common:windows --credential_helper=*.pkg.dev=%workspace%/build/bazel/tools/credhelper.cmd

build:windows --bes_keywords=windows
build:windows --host_platform=//tools/base/bazel/platforms:windows
build:windows --platforms=//tools/base/bazel/platforms:windows
build:windows --shell_executable=C:\\tools\\msys64\\usr\\bin\\bash.exe
# Needed to build the latest version of @com_google_protobuf//:protoc
build:windows --host_linkopt=/DEFAULTLIB:libcmt.lib
# Runfiles is off by default for Windows, enable it.
build:windows --enable_runfiles
# Static link native artifacts
build:windows --features=static_link_msvcrt
# Windows only supports worker,local strategies, sandboxed not supported.
build:windows --dynamic_local_strategy=worker,local
# Workaround for b/277781554 where bazel fails to clean up python zips
build:windows --nobuild_python_zip
build:windows --workspace_status_command="tools/base/bazel/workspace.cmd"

#
# Mac
#
common:macos --repo_env=ANDROID_NDK_HOME=$WORKSPACE_ROOT/prebuilts/studio/sdk/darwin/ndk/28.2.13676358
common:macos --credential_helper=chrome-infra-packages.appspot.com=%workspace%/build/bazel/tools/credhelper
common:macos --credential_helper=storage.googleapis.com=%workspace%/build/bazel/tools/credhelper
common:macos --credential_helper=*.pkg.dev=%workspace%/build/bazel/tools/credhelper

# supports_dynamic_linker cannot be used on MacOS, or will cause thread-local
# failures in protobuf. Other libraries (grpc) have encountered this issue,
# see https://github.com/bazelbuild/bazel/issues/4341.
build:macos --features=-supports_dynamic_linker
build:macos --bes_keywords=macos
build:macos --host_platform=//tools/base/bazel/platforms:macos
build:macos --platforms=//tools/base/bazel/platforms:macos
build:macos --watchfs
build:macos --workspace_status_command="prebuilts/python/darwin-x86/bin/python3 tools/base/bazel/workspace.py"
