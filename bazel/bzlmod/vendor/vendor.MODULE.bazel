android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
android_ndk.configure(
    api_level = 27,
)
use_repo(android_ndk, "androidndk")

register_toolchains("@androidndk//:all")

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

new_local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "new_local_repository")

new_local_repository(
    name = "freetype",
    build_file = "//tools/vendor/google/skia:external/freetype.BUILD",
    path = "external/freetype",
)

new_local_repository(
    name = "libpng",
    build_file = "//tools/vendor/google/skia:external/libpng.BUILD",
    path = "external/libpng",
)

local_repository(
    name = "skia_repo",
    path = "external/skia",
)

# buildifier: disable=external-path
local_repository(
    name = "skia_user_config",
    path = "tools/vendor/google/skia/external/skia-user-config",
)

# ASwB test deps are in a different directory for ownership.
include("//tools/adt/idea/aswb/testing/test_deps:test_deps.MODULE.bazel")

# Journeys evals test artifacts
include("//tools/vendor/google/ml/aiplugin/android/journeys-evals:test_artifacts.MODULE.bazel")

# Android Bench test artifacts
include("//tools/vendor/google/ml/aiplugin/android/eval:bench_repos.MODULE.bazel")
