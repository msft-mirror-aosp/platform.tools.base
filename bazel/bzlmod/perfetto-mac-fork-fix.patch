diff --git a/src/trace_processor/util/symbolizer/subprocess_posix.cc b/src/trace_processor/util/symbolizer/subprocess_posix.cc
index aaeed29..4e99bd2 100644
--- a/src/trace_processor/util/symbolizer/subprocess_posix.cc
+++ b/src/trace_processor/util/symbolizer/subprocess_posix.cc
@@ -25,6 +25,10 @@
 #include <algorithm>
 #include <cstring>
 
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_APPLE)
+#include <spawn.h>
+#endif
+
 #include "perfetto/ext/base/utils.h"
 
 extern "C" char** environ;
@@ -54,6 +58,23 @@ Subprocess::Subprocess(const std::string& file,
       environment.push_back(*entry);
   }
   environment.push_back(nullptr);
+#if PERFETTO_BUILDFLAG(PERFETTO_OS_APPLE)
+  posix_spawn_file_actions_t fa;
+  posix_spawn_file_actions_init(&fa);
+  posix_spawn_file_actions_adddup2(&fa, *input_pipe_.rd, STDIN_FILENO);
+  posix_spawn_file_actions_adddup2(&fa, *output_pipe_.wr, STDOUT_FILENO);
+
+  if (posix_spawnp(&pid_, file.c_str(), &fa, nullptr, c_str_args.data(),
+                   environment.data()) != 0) {
+    // Like a forked child that fails to exec: callers probing for
+    // llvm-symbolizer see it as unavailable instead of aborting. Writes fail
+    // and reads see EOF.
+    pid_ = -1;
+    input_pipe_.rd.reset();
+    input_pipe_.wr.reset();
+  }
+  posix_spawn_file_actions_destroy(&fa);
+#else
   if ((pid_ = fork()) == 0) {
     environ = environment.data();
     // Child
@@ -65,6 +86,7 @@ Subprocess::Subprocess(const std::string& file,
     _exit(127);
   }
   PERFETTO_CHECK(pid_ != -1);
+#endif
   // Keep input_pipe_.rd open to avoid SIGPIPE if the process exits.
   output_pipe_.wr.reset();
 }
