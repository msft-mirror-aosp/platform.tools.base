# Electron 43.4.1 TypeScript declarations and prebuilt desktop binaries.
#
# Note: The `electron` npm package does not contain the native binaries; its
# postinstall lifecycle script (install.js) attempts to download the binary zip
# from GitHub via Node.js. In Bazel CI, build actions execute in network-
# isolated sandboxes, which breaks npm lifecycle hooks.
#
# Instead, we download the official GitHub release artifacts directly via
# Bazel repository rules (http_file / http_archive). This ensures hermeticity,
# validates SHA-256 integrity during the repository fetch phase, and automatically
# routes through the GCS build-deps mirror in CI per
# tools/base/bazel/ci/data/downloader.cfg (see go/studio-ci#gcs-mirror).
http_file(
    name = "electron_types",
    downloaded_file_path = "electron.d.ts",
    sha256 = "e70d34f8d5d246bca8e39b3897b47e005c0f629673315b6f97ccae0f2405e7b8",
    urls = ["https://github.com/electron/electron/releases/download/v43.4.1/electron.d.ts"],
)

