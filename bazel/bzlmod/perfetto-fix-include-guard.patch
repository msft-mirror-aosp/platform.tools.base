From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zach Yu <zachyu@google.com>
Date: Thu, 4 Jun 2026 17:57:06 -0700
Subject: [build] Fix include guard

Bzlmod uses '+' in canonical repository names (e.g., 'perfetto+'),
which propagates into the generated header guard macros. Since '+'
is not a valid character for C++ preprocessor identifiers, the
compiler truncates the macro name at '+', leading to collisions.
Sanitize include guard names by replacing non-alphanumeric characters
with underscores.

diff --git a/python/tools/cpp_blob_emitter.py b/python/tools/cpp_blob_emitter.py
index a8fa509e..440c76d9 100755
--- a/python/tools/cpp_blob_emitter.py
+++ b/python/tools/cpp_blob_emitter.py
@@ -36,6 +36,7 @@ from __future__ import print_function
 
 import argparse
 import os
+import re
 import sys
 import textwrap
 import zlib
@@ -106,8 +107,7 @@ def derive_include_guard(output_path, gen_dir=''):
   """
   rel = os.path.relpath(output_path,
                         gen_dir) if gen_dir else os.path.basename(output_path)
-  return rel.replace('\\', '_').replace('/', '_').replace('.',
-                                                          '_').upper() + '_'
+  return re.sub(r'[^A-Z0-9_]', '_', rel.upper()) + '_'
 
 
 def emit_array(data, output_path, *, symbol, namespace, include_guard):
