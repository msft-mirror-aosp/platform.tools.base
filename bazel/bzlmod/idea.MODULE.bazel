# Expose modules in //tools/idea and rename them to make it clear where they come from.
# Keep local_path_override modules in sync with bazel_diff._EXCLUDED_BZLMOD_REPOS.
bazel_dep(name = "community", repo_name = "tools_idea")
local_path_override(
    module_name = "community",
    path = "tools/idea",
)

bazel_dep(name = "rules_jvm", repo_name = "tools_idea_rules_jvm")
local_path_override(
    module_name = "rules_jvm",
    path = "tools/idea/build/jvm-rules",
)

bazel_dep(name = "lib", repo_name = "tools_idea_lib")
local_path_override(
    module_name = "lib",
    path = "tools/idea/lib",
)

# Required because tools/idea/MODULE.bazel declares a bazel_dep on jps_to_bazel without a version.
# Sub-module path overrides are ignored by Bzlmod, so the root module must specify the path override.
bazel_dep(name = "jps_to_bazel", repo_name = "tools_idea_jps_to_bazel")
local_path_override(
    module_name = "jps_to_bazel",
    path = "tools/idea/platform/build-scripts/bazel",
)

# Overrides rules_kotlin to match the JetBrains fork version defined in tools/idea/MODULE.bazel.
# Bzlmod ignores archive_overrides in sub-modules, so it must be specified at the root level.
archive_override(
    module_name = "rules_kotlin",
    sha256 = "f9e4ad312589048535bf9bdbbc9b0c8df22727d3d2b0bd224f9aba10f3069230",
    strip_prefix = "rules_kotlin-f67028ddfa868b004432036d712bc8a79c9a1f30",
    url = "https://github.com/JetBrains/rules_kotlin/archive/f67028ddfa868b004432036d712bc8a79c9a1f30.zip",
)

# Required to import @community//plugins/kotlin:kotlin_test_dependencies.bzl
# https://fusion2.corp.google.com/invocations/b7cee79e-d32f-4eb0-a305-ad25107baa32
kotlin_test_deps = use_repo_rule("@tools_idea//plugins/kotlin:kotlin_test_dependencies.bzl", "kotlin_test_deps")

kotlin_test_deps(name = "kotlin_test_deps")

# Copied from tools/idea/debugger_test_deps.MODULE.bazel
# This file is originally included in tools/idea/MODULE.bazel but that breaks the build
# because the include is not allowed from a sub module.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "debugger_test_deps_debugger_agent",
    downloaded_file_path = "debugger-agent.jar",
    sha256 = "37f0ebd285fad3e02b9f3000cf7088c96b3141121dadd6a205c78307f48073ca",
    url = "https://cache-redirector.jetbrains.com/packages.jetbrains.team/maven/p/ij/intellij-dependencies/org/jetbrains/intellij/deps/debugger-agent/1.191/debugger-agent-1.191.jar",
)
