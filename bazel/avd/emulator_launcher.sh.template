#!/bin/bash

# =================================================================================
# Emulator Snapshot and Launch Script
#
# This script is a self-contained utility to create emulator snapshots and to
# launch emulators from those snapshots for fast startup. It's designed for
# Bazel test targets and can manage multiple, distinct system images.
#
# It operates in three modes:
#
# 1. Create Snapshot:
#    create-snapshot <port>
#    - Creates an AVD, boots it, and saves a snapshot for future use.
#
# 2. Launch from Snapshot:
#    <port>
#    - Creates or reuses a unique AVD from a pre-existing snapshot and
#      launches a read-only emulator instance. The port number doesn't
#      have to match the one used for snapshot creation.
#
# 3. Kill Emulator:
#    kill <port>
#    - Kills the running emulator instance on the specified port.
#
# Note: The `%...%` values are placeholders that are replaced by a build
# system (e.g., Bazel) when this script is generated.
# =================================================================================

# --- Argument Parsing ---

if [ "$#" -eq 0 ] || [ "$#" -gt 2 ]; then
  echo "Usage: $0 <port>                 (to launch)" >&2
  echo "   or: $0 create-snapshot <port> (to create a snapshot)" >&2
  echo "   or: $0 kill <port>            (to kill an emulator)" >&2
  exit 1
fi

# Default to 'launch' mode if only one argument is given.
if [ "$1" = "create-snapshot" ] || [ "$1" = "kill" ]; then
  readonly mode="$1"
  readonly port="$2"
else
  readonly mode="launch"
  readonly port="$1"
fi

# Validate that the port is a number.
if ! [[ "$port" =~ ^[0-9]+$ ]]; then
  echo "Error: Invalid or missing port number '$port'." >&2
  exit 1
fi

# The serial name used by ADB to identify the emulator instance.
readonly device_serial="emulator-${port}"

# --- System Image and Path Configuration ---

# Locate the source.properties file for the system image.
# The build system provides two possible paths.
if [ -f "%source_properties_short_path%" ]; then
  source_properties_path="%source_properties_short_path%"
elif [ -f "%source_properties_path%" ]; then
  source_properties_path="%source_properties_path%"
else
  echo "Error: System image's source.properties file not found." >&2
  exit 1
fi

# The AVD name is provided by the build system.
avd_name="%avd_name%"
emulator_path="%emulator_path%"

# The target directory where the snapshot will be stored or read from.
snapshot_dir_path="%snapshot_dir_path%"
snapshot_dir_short_path="%snapshot_dir_short_path%"


# --- Environment and Timeout Setup ---

# Set the emulator boot timeout. Default is 200s, but can be overridden.
# When launching from a snapshot, this value is reduced significantly.
emulator_boot_timeout=${EMULATOR_BOOT_TIMEOUT:-200}
echo "Initial emulator boot timeout is $emulator_boot_timeout seconds."

# --- Timeouts for wait loops ---
readonly kill_wait_timeout=60      # 1 minute to wait for `kill` command.
readonly snapshot_save_timeout=120 # 2 minutes to wait for the emulator to save the snapshot.

# Determine the host operating system to locate the correct SDK tools.
if [ "$(uname)" = "Darwin" ]; then
  OS_DIR_NAME=darwin
elif [ "$(uname)" = "Linux" ]; then
  OS_DIR_NAME=linux
else
  echo "Error: Windows is not supported."
  exit 1
fi

# Set up an isolated Android environment to avoid conflicts with the user's
# local setup. All paths are relative to the current working directory.
export HOME=$(pwd)
export ANDROID_PREFS_ROOT=$HOME
export ANDROID_HOME=$HOME/prebuilts/studio/sdk/$OS_DIR_NAME
export ANDROID_USER_HOME=$HOME/.android
export ANDROID_EMULATOR_HOME=$ANDROID_USER_HOME
export ANDROID_AVD_HOME=$ANDROID_EMULATOR_HOME/avd

# --- Binary Paths ---
emulator="$emulator_path"
adb="prebuilts/studio/sdk/$OS_DIR_NAME/platform-tools/adb"

# Enable verbose logging to aid in debugging emulator launch failures.
additional_emulator_args=("-verbose" "-show-kernel")


# --- Command Handling: Kill ---

# Handle the 'kill' command to terminate a running emulator.
if [ "$mode" = "kill" ]; then
  echo "Killing emulator on port $port ($device_serial)..."
  $adb -s "$device_serial" emu kill &>/dev/null

  # Wait for the emulator to fully disconnect from ADB.
  echo "Waiting for $device_serial to go offline..."
  kill_start_time=$SECONDS
  while true; do
    # Check the device state. An empty output means the device is offline.
    output=$($adb -s "$device_serial" get-state 2>/dev/null)
    if [ -z "$output" ]; then
      echo "Emulator $device_serial is offline."
      break
    fi

    if [ $((SECONDS - kill_start_time)) -gt "$kill_wait_timeout" ]; then
      echo "Error: Timed out after $kill_wait_timeout seconds waiting for $device_serial to go offline." >&2
      exit 1
    fi

    echo "Emulator state is still '$output'. Waiting..."
    sleep 1
  done
  exit $?
fi


# --- AVD and ADB Setup ---

# Create the .android directory if it's missing.
if [ ! -d "$ANDROID_USER_HOME" ]; then
  echo "Creating isolated Android user directory at $ANDROID_USER_HOME."
  mkdir -p "$ANDROID_USER_HOME"
fi

# Generate an ADB key if one doesn't exist. This key is injected into the
# emulator to authorize the ADB connection for user/debug builds.
if [ ! -f "$ANDROID_EMULATOR_HOME/adbkey" ]; then
  echo "ADB key not found. Generating new key at $ANDROID_EMULATOR_HOME/adbkey."
  $adb keygen "$ANDROID_EMULATOR_HOME/adbkey"
fi

# --- Command Handling: Create Snapshot vs. Launch ---

# This variable will hold the name of the AVD to be launched. It will be the
# base name for snapshot creation, and a unique name for a regular launch.
declare avd_name_to_launch

if [ "$mode" = "create-snapshot" ]; then
  # --- Mode: Create Snapshot ---
  echo "Starting snapshot creation process for target dir: $(pwd)/$snapshot_dir_path"

  # For snapshot creation, use the base AVD name. This process runs only
  # once at build time to create the snapshot, so a unique,
  # port-suffixed name is not necessary here.
  readonly avd_name_to_launch="$avd_name"

  # Start from a clean boot to ensure a consistent snapshot.
  additional_emulator_args+=("-no-snapshot-load")

  # Read API level and ABI type from the system image's source.properties file.
  echo "Reading properties from $source_properties_path..."
  if [ "$(uname)" = "Darwin" ]; then
    api_level="$(sed -En 's/AndroidVersion.ApiLevel=(.*)/\1/p' "$source_properties_path")"
    abi_type="$(sed -En 's/SystemImage.Abi=(.*)/\1/p' "$source_properties_path")"
  else
    api_level="$(sed -rn 's/AndroidVersion.ApiLevel=(.*)/\1/p' "$source_properties_path")"
    abi_type="$(sed -rn 's/SystemImage.Abi=(.*)/\1/p' "$source_properties_path")"
  fi

  if [ -z "$api_level" ]; then
    echo "Error: Could not parse API level from source.properties." >&2
    exit 1
  fi
  if [ -z "$abi_type" ]; then
    echo "Error: Could not parse ABI type from source.properties." >&2
    exit 1
  fi
  echo "Found API level: $api_level, ABI type: $abi_type"

  # The emulator's `hw.cpu.arch` property sometimes differs from the ABI type.
  # Adjust for arm64.
  if [ "$abi_type" = "arm64-v8a" ]; then
    hw_cpu_arch="arm64"
  else
    hw_cpu_arch="$abi_type"
  fi

  # Create an AVD named after the unique build target (`avd_name`) to support multiple system images.
  echo "Creating AVD '$avd_name_to_launch' with API $api_level ($abi_type)..."
  system_image_dir=$(pwd)/$(dirname "$source_properties_path")
  mkdir -p "$ANDROID_AVD_HOME/$avd_name_to_launch.avd"

  # Create the main AVD configuration file.
  cat >"$ANDROID_AVD_HOME/$avd_name_to_launch.ini" <<EOF
avd.ini.encoding=UTF-8
path=$ANDROID_AVD_HOME/$avd_name_to_launch.avd
path.rel=avd/$avd_name_to_launch.avd
target=android-$api_level
EOF

  # Create the detailed hardware configuration file (config.ini) with generic Pixel properties.
  cat >"$ANDROID_AVD_HOME/$avd_name_to_launch.avd/config.ini" <<EOF
PlayStore.enabled=false
abi.type=$abi_type
avd.ini.encoding=UTF-8
hw.accelerometer=yes
hw.audioInput=yes
hw.battery=yes
hw.cpu.arch=$hw_cpu_arch
hw.dPad=no
hw.device.hash2=MD5:524882cfa9f421413193056700a29392
hw.device.manufacturer=Google
hw.device.name=pixel
hw.gps=yes
hw.lcd.density=480
hw.lcd.height=1920
hw.lcd.width=1080
hw.mainKeys=no
hw.sdCard=yes
hw.sensors.orientation=yes
hw.sensors.proximity=yes
hw.trackBall=no
image.sysdir.1=$system_image_dir
EOF
else
  # --- Mode: Launch from Snapshot ---
  # Generate a unique AVD name for this instance by suffixing the port number.
  # This prevents conflicts when launching multiple emulators from the same base snapshot.
  readonly instance_avd_name="${avd_name}-${port}"
  readonly instance_avd_dir="$ANDROID_AVD_HOME/${instance_avd_name}.avd"
  readonly instance_ini_file="$ANDROID_AVD_HOME/${instance_avd_name}.ini"
  readonly avd_name_to_launch="$instance_avd_name"

  # Add emulator flags for running from a read-only snapshot.
  additional_emulator_args+=("-read-only" "-no-snapshot-save")

  if [ "$(uname)" = "Linux" ]; then
    # Add `-force-snapshot-load` to prevent the emulator from deleting the
    # default snapshot on a failed boot.
    #
    # This flag is currently enabled only on Linux because the emulator version
    # on the studio-mac, studio-mac-arm build bots is too old and does not support it.
    # It should be enabled for macOS once the emulator is updated.
    additional_emulator_args+=("-force-snapshot-load")
  fi

  # Verify that the parent snapshot directory exists before proceeding.
  if [ ! -d "$snapshot_dir_short_path" ]; then
    echo "Error: Snapshot directory not found at '$snapshot_dir_short_path'." >&2
    echo "Please run this script with the 'create-snapshot' command first." >&2
    exit 1
  fi

  # Do not reuse the previous AVD instance. Even if you launch emulator with
  # `-read-only` mode, it can modify files in the avd folder and sometimes it
  # ends up becoming a corrupted state, leading to a boot failure.
  if [ -d "$instance_avd_dir" ] || [ -f "$instance_ini_file" ]; then
    echo "Deleting existing AVD instance '$instance_avd_name'."
    rm -f "$instance_ini_file"
    rm -rf "$instance_avd_dir"
  fi

  # --- Create a unique AVD instance from the snapshot ---
  echo "Creating new AVD instance '$instance_avd_name' from snapshot..."

  # First, ensure the parent AVD directory exists.
  mkdir -p "$ANDROID_AVD_HOME"

  # Copy the snapshot AVD content to the unique instance directory.
  echo "Copying snapshot for '$avd_name' to $instance_avd_dir..."
  cp -RL "$snapshot_dir_short_path/$avd_name.avd" "$instance_avd_dir"
  chmod -R +w "$instance_avd_dir"

  # The snapshot contains absolute paths that must be updated.
  echo "Relocating paths in snapshot's .ini files..."
  for file in $(grep -rl "__PLACEHOLDER_EXTERNAL__" --include="*.ini" "$instance_avd_dir"); do
    if [ "$(uname)" = "Darwin" ]; then
      sed -i '' "s#__PLACEHOLDER_EXTERNAL__#$HOME/..#g" "$file"
    else
      sed -i "s#__PLACEHOLDER_EXTERNAL__#$HOME/..#g" "$file"
    fi
  done
  for file in $(grep -rl "__PLACEHOLDER_HOME__" --include="*.ini" "$instance_avd_dir"); do
    if [ "$(uname)" = "Darwin" ]; then
      sed -i '' "s#__PLACEHOLDER_HOME__#$HOME#g" "$file"
    else
      sed -i "s#__PLACEHOLDER_HOME__#$HOME#g" "$file"
    fi
  done
  for file in $(grep -rl "avd/$avd_name.avd" --include="*.ini" "$instance_avd_dir"); do
    if [ "$(uname)" = "Darwin" ]; then
      sed -i '' "s#avd/$avd_name.avd#avd/$instance_avd_name.avd#g" "$file"
    else
      sed -i "s#avd/$avd_name.avd#avd/$instance_avd_name.avd#g" "$file"
    fi
  done

  # The original .ini (named after the base avd) is inside the snapshot directory for portability.
  # We rename and move it to its final destination, which will have the unique instance name.
  mv "$instance_avd_dir/$avd_name.ini" "$instance_ini_file"

  echo "Snapshot is ready."
fi


# --- Emulator Launch and Boot-wait Loop ---

# Redirect emulator output to a temporary log file. This allows the script
# to display the log during boot and then detach, preventing the parent
# process (e.g., Bazel) from hanging while waiting for stdout to close.
readonly emu_log_file="/tmp/emulator-log-${port}.txt"

# Ensure the log file is clean for this run.
rm -f "$emu_log_file"
touch "$emu_log_file"

# Display the emulator's log in real-time.
tail -f "$emu_log_file" &
readonly tail_pid=$!

# Set a trap to kill the tail process and clean up the log file when this script exits.
# This is the key to detaching the emulator's output from this script's stdout.
trap 'kill $tail_pid 2>/dev/null; rm -f "$emu_log_file"' EXIT

echo "Attempting to launch emulator '$avd_name_to_launch' on port $port ($device_serial)..."
boot_complete=false

if [ "$mode" = "create-snapshot" ]; then
  # Retry snapshot creation to handle transient environment flakes.
  retry_attempts=(1 2 3)
else
  # In 'launch' mode, a failure often indicates a corrupted snapshot,
  # so we do not retry.
  retry_attempts=(1)
fi

for i in "${retry_attempts[@]}"; do
  start_time=$SECONDS
  # Launch the emulator in the background, redirecting its output to the log file.
  # Common flags are used for headless CI environments.
  $emulator \
    -avd "$avd_name_to_launch" \
    -port "$port" \
    -delay-adb \
    -no-window \
    -gpu swiftshader_indirect \
    -feature -ModemSimulator \
    -feature -MultiDisplay \
    "${additional_emulator_args[@]}" \
    >> "$emu_log_file" 2>&1 &
  emu_pid=$!
  echo "Emulator process started with PID $emu_pid (Attempt $i)."

  # Wait for the emulator to finish booting.
  echo "Waiting for $device_serial to boot..."

  # Poll the emulator state until it's fully booted or the timeout is reached.
  # `kill -0 $emu_pid` checks if the process is still running without sending a signal.
  while kill -0 $emu_pid 2>/dev/null; do
    output=$($adb -s "$device_serial" shell getprop sys.boot_completed 2>&1)
    elapsed_time=$((SECONDS - start_time))

    # Check for ADB authorization issues. This should not happen with a correctly generated adbkey.
    if [[ $output == *"unauthorized"* ]]; then
      echo "Error: Emulator requires ADB authorization." >&2
      kill -9 $emu_pid
      exit 1
    fi

    # '1' indicates the boot process is complete.
    if [ "${output:0:1}" = "1" ]; then
      echo "Emulator booted successfully in $elapsed_time seconds."
      boot_complete=true
      break
    fi

    if [ "$elapsed_time" -gt "$emulator_boot_timeout" ]; then
      echo "Emulator did not boot within the $emulator_boot_timeout second timeout."
      break
    fi
    sleep 1
  done

  if [ "$boot_complete" = true ]; then
    break
  fi

  echo "$device_serial failed to come online. Killing PID $emu_pid and retrying..."
  kill -9 $emu_pid 2>/dev/null
  sleep 2
done


# --- Finalization ---

if [ "$boot_complete" = true ]; then
  echo "$device_serial is online and ready."

  # If in 'create-snapshot' mode, kill the emulator gracefully to save the snapshot,
  # then move the AVD data to the final snapshot directory.
  if [ "$mode" = "create-snapshot" ]; then
    echo "Saving snapshot..."
    $adb -s "$device_serial" emu kill

    # Wait for the emulator process to shut down. This can take time as it saves state.
    echo "Waiting for emulator process to terminate gracefully..."
    shutdown_start_time=$SECONDS
    while kill -0 $emu_pid 2>/dev/null; do
      if [ $((SECONDS - shutdown_start_time)) -gt "$snapshot_save_timeout" ]; then
        echo "Warning: Emulator did not shut down gracefully within $snapshot_save_timeout seconds. Forcing kill." >&2
        kill -9 $emu_pid 2>/dev/null
        break
      fi
      sleep 1
    done

    wait $emu_pid
    echo "Emulator process finished. Finalizing snapshot..."

    # For portability, copy the .ini file into the .avd directory.
    # This makes the snapshot self-contained, as it will be moved back out during launch.
    cp "$ANDROID_AVD_HOME/$avd_name_to_launch.ini" "$ANDROID_AVD_HOME/$avd_name_to_launch.avd/$avd_name_to_launch.ini"

    snapshot_from="$ANDROID_AVD_HOME/$avd_name_to_launch.avd"
    echo "Moving AVD data from $snapshot_from to $snapshot_dir_path/..."
    mkdir -p "$snapshot_dir_path"
    mv "$snapshot_from" "$snapshot_dir_path/"

    # Make the snapshot relocatable by replacing absolute paths with placeholders.
    # We search inside the destination directory where the AVD was just moved.
    echo "Replacing absolute paths in snapshot's .ini files with placeholders..."
    for file in $(grep -rl "$HOME/external" --include="*.ini" "$snapshot_dir_path/$avd_name_to_launch.avd"); do
      if [ "$(uname)" = "Darwin" ]; then
        sed -i '' "s#$HOME/external#__PLACEHOLDER_EXTERNAL__#g" "$file"
      else
        sed -i "s#$HOME/external#__PLACEHOLDER_EXTERNAL__#g" "$file"
      fi
    done
    for file in $(grep -rl "$HOME" --include="*.ini" "$snapshot_dir_path/$avd_name_to_launch.avd"); do
      if [ "$(uname)" = "Darwin" ]; then
        sed -i '' "s#$HOME#__PLACEHOLDER_HOME__#g" "$file"
      else
        sed -i "s#$HOME#__PLACEHOLDER_HOME__#g" "$file"
      fi
    done
    echo "Snapshot created successfully at $snapshot_dir_path/$avd_name_to_launch.avd."
  else
    # In 'launch' mode, inform the user that the script is detaching.
    echo "Detaching script from emulator output. The process (PID $emu_pid) will continue running in the background."
  fi
else
  echo "Error: Emulator failed to boot after all retries." >&2
  exit 1
fi
